# ---------------------------------------------------------------------------
# QRadar IOC Exporter — configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- QRadar Connection -----------------------------------------------------
QRADAR_HOST=192.168.1.100          # QRadar Console IP or FQDN (no scheme)
QRADAR_API_TOKEN=your-sec-token-here
QRADAR_VERIFY_SSL=false            # Set true in production with a valid cert
QRADAR_API_VERSION=20.0

# --- Reference Set Names (exact names as they appear in QRadar) ------------
REFSET_IP=Blocked_IPs
REFSET_HASH=Blocked_Hashes
REFSET_DOMAIN=Blocked_Domains
REFSET_URL=Blocked_URLs

# --- Sync Schedule ---------------------------------------------------------
SYNC_INTERVAL_SECONDS=300          # How often to poll QRadar (default: 5 min)
INITIAL_SYNC_ON_STARTUP=true

# --- Service ---------------------------------------------------------------
SERVICE_PORT=8443
ENABLE_TLS=true                    # false = serve plain HTTP (no self-signed cert)
LOG_LEVEL=INFO
REQUIRE_AUTH=true                  # false (or empty API_KEY) = feeds served without auth
API_KEY=changeme-secret-key        # Bearer token protecting the feed endpoints
