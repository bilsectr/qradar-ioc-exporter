# Production deployment using the pre-built, signed image from GHCR.
#
# Copy to `docker-compose.prod.yml`, replace OWNER with your GitHub
# user/org (lowercase), then deploy with:
#
#   docker compose -f docker-compose.prod.yml pull
#   docker compose -f docker-compose.prod.yml up -d
#
# Pin to a released version (e.g. :1.2.3) in production rather than :latest/:edge.
services:
  qradar-ioc-exporter:
    image: ghcr.io/OWNER/qradar-ioc-exporter:latest   # or :1.2.3 / :edge
    container_name: qradar-ioc-exporter
    restart: unless-stopped
    ports:
      - "8443:8443"
    env_file:
      - .env
    volumes:
      - ./certs:/app/certs
      - ./logs:/app/logs
    read_only: true
    tmpfs:
      - /tmp
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    healthcheck:
      test: ["CMD", "python", "-m", "app.healthcheck"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 15s
